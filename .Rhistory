#' plastic collected and adds a linear trend line.
#'
#' @param data A data frame containing temperature and plastic collection data.
#' @param country_label A character value used to label the highlighted country.
#'
#' @return A ggplot object.
#' @export
#'
#' @examples
#' plot_temp_plastic_hex(plastic_temp_gdp, country_label = "Nigeria")
plot_temp_plastic_hex <- function(data, country_label = "Nigeria") {
top_point <- data |>
dplyr::slice_max(grand_total, n = 1)
ggplot2::ggplot(data, ggplot2::aes(x = AnnualMeanTemp, y = log(grand_total))) +
ggplot2::geom_hex() +
ggplot2::geom_smooth(method = "lm", se = FALSE) +
ggplot2::geom_point(
data = top_point,
ggplot2::aes(x = AnnualMeanTemp, y = log(grand_total)),
size = 3
) +
ggplot2::geom_text(
data = top_point,
ggplot2::aes(
x = AnnualMeanTemp,
y = log(grand_total),
label = Country
),
vjust = -1
) +
ggplot2::labs(
x = "Mean Annual Temperature",
y = "Log Total Plastic Collected",
fill = "Countries",
title = paste("Temperature and Plastic Collected:", country_label)
)
}
View(plot_temp_plastic_hex)
